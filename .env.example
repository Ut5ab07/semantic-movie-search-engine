# Deployment Environment (development / production)
ENVIRONMENT=development

# Server Port (used by Render)
PORT=8000

# Allowed CORS origins (comma-separated). In production, set to your Vercel frontend URL.
# Example: ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedding model to load (sentence-transformers)
MODEL_NAME=all-MiniLM-L6-v2
